# Copy to .env and fill in. Never commit the real .env.

# --- Required ---
# https://developer.company-information.service.gov.uk/ (free registration)
COMPANIES_HOUSE_API_KEY=your_companies_house_key
# https://aistudio.google.com/apikey  (or use Vertex AI below instead)
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-3.5-flash

# --- Vertex AI instead of the Gemini API (recommended for production quota) ---
# No API key needed: authentication uses the service account / ADC identity.
# Use "global"; regional endpoints such as europe-west1 do not serve gemini-3.5-flash.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# --- Fleet security ---
# HMAC key for agent identity tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a development key is generated under FLEET_STATE_DIR.
# FLEET_SIGNING_KEY=
# Legacy single shared secret. Still accepted, but unattributable and not
# revokable on its own. Prefer per-caller keys:
#   python api_keys.py issue --name "ci-pipeline" --scopes audits:read audits:write
# FLEET_API_KEY=
# Comma-separated key ids to refuse despite a valid signature. Read on every
# request, so revoking needs no redeploy. A Secret Manager value works well.
# FLEET_REVOKED_KEY_IDS=
# Defaults applied when issuing a key.
# FLEET_KEY_DEFAULT_TTL_DAYS=30
# FLEET_KEY_DEFAULT_REQUESTS_PER_HOUR=600
# FLEET_KEY_DEFAULT_AUDITS_PER_HOUR=20
# Shared code the browser console asks for, exchanged once at POST /api/session for a
# session cookie. Setting it also locks the API to signed-in clients. Unset means open
# (local development); set it before publishing the console publicly.
# FLEET_CONSOLE_ACCESS_CODE=

# --- HTTP hardening (all optional, defaults shown) ---
# Console sign-in throttle. State is per process; multiple Cloud Run instances
# multiply these budgets, so keep the access code long and random regardless.
# FLEET_SIGNIN_MAX_PER_CALLER=10
# FLEET_SIGNIN_MAX_GLOBAL=100
# FLEET_SIGNIN_WINDOW_SECONDS=900
# Caps queued + running audits, which caps model spend.
# FLEET_MAX_PENDING_JOBS=25
# Pins the OpenAPI server URL instead of trusting the Host header.
# FLEET_PUBLIC_URL=https://your-service.run.app

# --- Fleet operations (all optional, defaults shown) ---
# FLEET_STATE_DIR=.fleet
# FLEET_TELEMETRY_DIR=telemetry
# DUE_DILIGENCE_RUNS_DIR=runs
# FLEET_RUNTIME_WORKERS=4
# FLEET_GATEWAY_QUOTA_PER_MINUTE=60
# FLEET_ALLOWED_EGRESS_HOSTS=api.company-information.service.gov.uk,document-api.company-information.service.gov.uk,generativelanguage.googleapis.com,aiplatform.googleapis.com
# FLEET_ENVIRONMENT=local
# FLEET_DATA_REGION=europe-west2

# --- Notifications (optional) ---
# Posted to when a job finishes, fails, or is cancelled. Slack or Google Chat
# incoming webhooks work as-is; any JSON endpoint is fine. Fixed configuration,
# never taken from a request.
# FLEET_NOTIFY_WEBHOOK=https://hooks.slack.com/services/...
# Included in the payload so a recipient can link back to the run.
# FLEET_CONSOLE_URL=https://your-console.run.app

# --- Telemetry export (optional) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# FLEET_CLOUD_TRACE=true
